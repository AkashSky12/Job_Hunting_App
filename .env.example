# ---- AI Job Hunter (MVP) environment ----
# All values are OPTIONAL. The app runs fully without any keys using a
# built-in TF-IDF matcher and heuristic CV parser.

# Set this to enable higher-quality LLM CV parsing + embedding-based matching.
# OPENAI_API_KEY=sk-...

# Model overrides (optional)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# SQLite database file (optional override)
# DATABASE_PATH=jobhunter.db

# ---- Adzuna job source (optional) ----
# Get free keys at https://developer.adzuna.com/
# ADZUNA_APP_ID=...
# ADZUNA_APP_KEY=...
# ADZUNA_COUNTRY=gb            # gb, us, etc.
# ADZUNA_QUERY=software engineer

# ---- JSearch aggregator via RapidAPI (optional) ----
# Aggregates LinkedIn, Indeed, Glassdoor, ZipRecruiter and more through ONE key.
# Subscribe (free tier) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# RAPIDAPI_KEY=...
# JSEARCH_HOST=jsearch.p.rapidapi.com

# ---- Default role/location (aggregated queries + deep-link searches) ----
# JOB_QUERY=software engineer
# JOB_LOCATION=remote

# ---- Gmail status auto-updates (optional) ----
# 1. Create an OAuth "Desktop app" client in Google Cloud Console, enable Gmail API.
# 2. Download the client secret as credentials.json into this folder.
# 3. Install libs: pip install google-api-python-client google-auth-oauthlib
# 4. First "Sync Gmail" click opens a browser to authorize (token.json is cached).
# GMAIL_CREDENTIALS_PATH=credentials.json
# GMAIL_TOKEN_PATH=token.json
